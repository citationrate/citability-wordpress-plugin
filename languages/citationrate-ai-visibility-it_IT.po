msgstr "Meta description %d caratteri, fuori dal range ideale (120-160)."

msgid "No duplicate main heading in the body."
msgstr "Nessun H1 duplicato nel corpo."

msgid "No duplicate main heading in the body (the theme provides the title)."
msgstr "Nessun H1 duplicato nel corpo (il tema fornisce il titolo)."

msgid "One main heading in the body: risk of a duplicate if the theme repeats it."
msgstr "Un H1 nel corpo: rischio di doppio H1 se il tema lo ripete."

msgid "%d main headings in the text: use subheadings for sections."
msgstr "%d tag H1 nel corpo: usa H2/H3 per le sezioni."

msgid "No headings found in the content."
msgstr "Nessun heading rilevato nel contenuto."

msgid "Good subheading structure (%1$d main, %2$d secondary)."
msgstr "Gerarchia heading buona: %1$d H2, %2$d H3."

msgid "Few subheadings: add 2-3 to structure the content."
msgstr "Pochi heading: aggiungi 2-3 H2 per strutturare il contenuto."

msgid "No subheadings: the text is one block, hard for AI to cite."
msgstr "Nessun H2: il contenuto è un blocco unico, difficile da citare per le AI."

msgid "Main keyword not set (requires Yoast or RankMath)."
msgstr "Focus keyword non impostata (richiede Yoast o RankMath)."

msgid "Main keyword present in the title."
msgstr "Focus keyword presente nel titolo."

msgid "Main keyword \"%s\" not present in the title."
msgstr "Focus keyword \"%s\" non presente nel titolo."

msgid "Author not detected."
msgstr "Autore non rilevato."

msgid "Author \"admin\": a real name builds more authority."
msgstr "Autore \"admin\": meglio un nome reale per costruire autorevolezza."

msgid "Author: %s."
msgstr "Autore: %s."

msgid "Publication date missing."
msgstr "Data di pubblicazione assente."

msgid "Different publish and update dates: a great freshness signal."
msgstr "Pubblicazione e ultimo aggiornamento differenti: ottimo segnale di freschezza."

msgid "Publication date present, no update signal."
msgstr "Data di pubblicazione presente, manca segnale di aggiornamento."

msgid "Author bio: %d characters, enough for authority."
msgstr "Bio autore: %d caratteri, sufficiente per autorevolezza."

msgid "Author bio present but too short (target ≥80 characters)."
msgstr "Bio autore presente ma troppo breve (target ≥80 caratteri)."

msgid "Author bio empty: update the WordPress user profile."
msgstr "Bio autore vuota: aggiorna il profilo utente WordPress."

msgid "Business details present (%s)."
msgstr "Schema %s presente."

msgid "Business details missing. Add them from the \"Help AI understand this page\" box."
msgstr "Schema Organization/LocalBusiness assente. Usa il wizard JSON-LD."

msgid "Optimal length: %d words."
msgstr "Lunghezza ottimale: %d parole."

msgid "Acceptable length: %d words (target ≥1200)."
msgstr "Lunghezza accettabile: %d parole (target ≥1200)."

msgid "Only %d words: content too short to be cited."
msgstr "Solo %d parole: contenuto troppo corto per essere citato."

msgid "Text too short to measure readability."
msgstr "Testo troppo corto per calcolare leggibilità."

msgid "Readability %d: easy for an AI to paraphrase."
msgstr "Leggibilità %d: facile da parafrasare per un'AI."

msgid "Readability %d: slightly complex."
msgstr "Leggibilità %d: leggermente complesso."

msgid "Readability %d: too complex."
msgstr "Leggibilità %d: troppo complesso."

msgid "%d internal links: great structure."
msgstr "%d link interni: ottima struttura."

msgid "%d internal links (target ≥3)."
msgstr "%d link interni (target ≥3)."

msgid "No internal links: related content increases citability."
msgstr "Nessun link interno: i contenuti correlati aumentano la citabilità."

msgid "%d outbound links to external sources: a good expertise signal."
msgstr "%d link in uscita verso fonti esterne: buon segnale di competenza."

msgid "1 outbound link: add at least one more authoritative source."
msgstr "1 link in uscita: aggiungi almeno una fonte autorevole in più."

msgid "No outbound links: AI rewards content that cites sources."
msgstr "Nessun link in uscita: le AI premiano i contenuti che citano fonti."

msgid "No images in the content."
msgstr "Nessuna immagine nel contenuto."

msgid "All %d images have alt text."
msgstr "Tutte le %d immagini hanno alt text."

msgid "%1$d of %2$d images without alt text: complete the rest."
msgstr "%1$d immagini su %2$d senza alt: completa il resto."

msgid "%1$d of %2$d images without alt text: add descriptions."
msgstr "%1$d immagini su %2$d senza alt: aggiungi descrizioni."

msgid "Structured questions and answers present."
msgstr "Schema FAQPage presente."

msgid "%d questions in the text: turn them into a Q&A section from the \"Help AI understand this page\" box."
msgstr "%d domande nel testo: aggiungi schema FAQPage tramite wizard."

msgid "No Q&A pattern. Q&A greatly increases AI citability."
msgstr "Nessun pattern FAQ. Le FAQ aumentano molto la citabilità AI."

msgid "Secure connection active."
msgstr "Sito su HTTPS."

msgid "Connection not secure: a minimum requirement for AI."
msgstr "Sito non in HTTPS: requisito minimo per indicizzazione AI."

msgid "Official page address handled by WordPress."
msgstr "Canonical URL gestito da WordPress core."

msgid "Official page address not detected: check your theme or SEO plugin."
msgstr "Canonical non rilevato in wp_head: verifica il tema o il plugin SEO."

msgid "Content cites external sources with attribution phrases."
msgstr "Contenuto cita fonti esterne con frasi di attribuzione."

msgid "Weak citations: add explicit attributions to authoritative sources."
msgstr "Citazioni deboli: aggiungi attribuzioni esplicite a fonti autorevoli."

msgid "No explicit citations: AI looks for verifiable content."
msgstr "Nessuna citazione esplicita: le AI cercano contenuti verificabili."

msgid "Social preview generated by your SEO plugin with a featured image."
msgstr "Open Graph generato da un plugin SEO e immagine in evidenza impostata."

msgid "Social preview incomplete: you need both an SEO plugin and a featured image."
msgstr "Open Graph parziale: serve sia un plugin SEO sia un'immagine in evidenza."

msgid "No social preview: shared content won't show a rich preview."
msgstr "Nessun Open Graph: i contenuti condivisi non avranno anteprime ricche."

msgid "X preview generated by the SEO plugin with an image."
msgstr "Twitter Card generata dal plugin SEO con immagine."

msgid "X preview without an image: set a featured image."
msgstr "Twitter Card senza immagine: imposta un'immagine in evidenza."

msgid "No SEO plugin detected: the X preview is not generated."
msgstr "Nessun plugin SEO rilevato: la Twitter Card non viene generata."

msgid "Site language set to %s."
msgstr "Lingua del sito impostata su %s."

msgid "Site language not set: AI engines can't tell the content language."
msgstr "Lingua del sito non impostata: i motori AI non riconoscono il linguaggio del contenuto."

msgid "Page hidden from search engines (Yoast setting): it won't appear in results."
msgstr "Post marcato come noindex (Yoast): non sarà indicizzato."

msgid "Page hidden from search engines (RankMath setting): it won't appear in results."
msgstr "Post marcato come noindex (RankMath): non sarà indicizzato."

msgid "Page still a draft: no engine will show it until it is published."
msgstr "Post ancora in bozza: nessun motore lo indicizzerà finché non è pubblicato."

msgid "Page visible to search engines."
msgstr "Post indicizzabile dai motori di ricerca."

msgid "Multilingual plugin active: other-language versions are linked automatically."
msgstr "Plugin multilingua attivo: hreflang vengono generati automaticamente."

msgid "Single-language site: no other-language links needed."
msgstr "Sito monolingua: hreflang non necessari."

msgid "Complete article card (author, publisher, image)."
msgstr "Markup Article completo (autore, publisher, immagine)."

msgid "Article card incomplete: add author, publisher and image."
msgstr "Markup Article parziale: completa autore, publisher e immagine."

msgid "Article card present but without author, publisher or image."
msgstr "Markup Article presente ma senza autore, publisher o immagine."

msgid "No article card saved: add one from the \"Help AI understand this page\" box."
msgstr "Nessun markup Article salvato: usa il wizard JSON-LD."

msgid "Author profile without a website: add a URL in the user settings to strengthen authority."
msgstr "Profilo autore senza sito web: aggiungi un URL nelle impostazioni utente per rafforzare autorevolezza."

msgid "Author profile linked to %s."
msgstr "Profilo autore collegato a %s."

msgid "Author profile linked to the same site: an external profile (LinkedIn, personal site) is better."
msgstr "Profilo autore collegato allo stesso sito: meglio un profilo esterno (LinkedIn, sito personale)."

msgid "Empty content."
msgstr "Contenuto vuoto."

msgid "Short article: a table of contents isn't needed."
msgstr "Articolo breve: l'indice non è necessario."

msgid "Table of contents present with %d sections."
msgstr "Indice navigabile presente con %d sezioni."

msgid "%d sections but no table of contents: add one."
msgstr "%d sezioni H2 ma nessun indice: aggiungi un Table of Contents."

msgid "Empty content: add an opening."
msgstr "Contenuto vuoto: aggiungi un'apertura."

msgid "No paragraph found."
msgstr "Nessun paragrafo trovato."

msgid "Opening too short (%d characters): start with a clear summary."
msgstr "Apertura troppo corta (%d caratteri): inizia con un riassunto chiaro."

msgid "Opening very long (%d characters): trim it to 1-2 dense sentences."
msgstr "Apertura molto lunga (%d caratteri): riducila a 1-2 frasi dense."

msgid "The opening doesn't contain the main keyword."
msgstr "L'apertura non contiene la parola chiave principale."

msgid "Informative opening of suitable length."
msgstr "Apertura informativa e di lunghezza adatta."

msgid "Short article: lists aren't needed."
msgstr "Articolo breve: gli elenchi non sono necessari."

msgid "Good use of lists: %d lists present."
msgstr "Buon uso di elenchi: %d liste presenti."

msgid "Only one list: add another to make the content easier to scan."
msgstr "Una sola lista: aggiungine un'altra per rendere il contenuto più scansionabile."

msgid "No bulleted/numbered lists: AI prefers structured content."
msgstr "Nessun elenco puntato/numerato: le AI preferiscono contenuti strutturati."

msgid "All %d images have explicit dimensions."
msgstr "Tutte le %d immagini hanno dimensioni esplicite."

msgid "%1$d of %2$d images without dimensions: complete the rest."
msgstr "%1$d immagini su %2$d senza dimensioni: completa il resto."

msgid "%1$d of %2$d images without dimensions: they hurt the visual experience."
msgstr "%1$d immagini su %2$d senza dimensioni: peggiorano l'esperienza visiva."

msgid "Text too short to analyze passive voice."
msgstr "Testo troppo corto per analizzare la forma passiva."

msgid "Direct style: only %d%% of sentences in passive voice."
msgstr "Stile diretto: solo %d%% delle frasi in forma passiva."

msgid "%d%% of sentences in passive voice: try rewriting some in active voice."
msgstr "%d%% delle frasi in forma passiva: prova a riscriverne qualcuna in attiva."

msgid "%d%% of sentences in passive voice: too many to be cited by AI."
msgstr "%d%% delle frasi in forma passiva: troppe per essere citate dalle AI."

msgid "Text too short to measure sentence length."
msgstr "Testo troppo corto per misurare la lunghezza delle frasi."

msgid "Short sentences (avg %d words): easy to quote verbatim."
msgstr "Frasi brevi (media %d parole): facili da citare in modo testuale."

msgid "Medium sentences (%d words): break up the longer ones."
msgstr "Frasi medie (%d parole): spezza quelle più lunghe."

msgid "Sentences too long (%d words): an AI will struggle to extract short answers."
msgstr "Frasi troppo lunghe (%d parole): un'AI faticherà a estrarre risposte brevi."

msgid "The year %d is mentioned in the text."
msgstr "L'anno %d è menzionato nel testo."

msgid "Year %1$d cited but not %2$d: update the time references."
msgstr "Citato l'anno %1$d ma non %2$d: aggiorna i riferimenti temporali."

msgid "No reference to the current year: AI penalizes content that seems outdated."
msgstr "Nessun riferimento all'anno corrente: le AI penalizzano contenuti percepiti come datati."

msgid "No paragraph in the content."
msgstr "Nessun paragrafo nel contenuto."

msgid "Well-sized paragraphs (%d total)."
msgstr "Paragrafi ben dimensionati (%d totali)."

msgid "%d paragraphs too long: break up the walls of text."
msgstr "%d paragrafi troppo lunghi: spezza i muri di testo."

msgid "%d paragraphs too long: the content is hard to scan."
msgstr "%d paragrafi troppo lunghi: il contenuto è difficile da scansionare."

